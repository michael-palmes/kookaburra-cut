{
  "version": 1,
  "name": "Feature hero",
  "text": {
    "title": "Smart week view",
    "subtitle": ""
  },
  "devices": [
    {
      "id": "hero",
      "model": "iphone-17-pro",
      "colour": "cosmic-orange",
      "media": {
        "src": "assets/kooka-feed-loop-sample.mp4",
        "kind": "video",
        "startMs": 0,
        "fit": "cover"
      },
      "placement": {
        "position": [0, -0.3, 0],
        "rotationDeg": [0, 0, 0],
        "scale": 1
      },
      "motion": {
        "preset": "none"
      },
      "shadow": "long"
    }
  ],
  "camera": {
    "keys": [
      {
        "id": "k1",
        "tMs": 0,
        "pose": {
          "target": [0, -0.2, 0],
          "azimuthDeg": -8,
          "elevationDeg": 4,
          "distance": 5.9,
          "dof": {
            "mode": "depth",
            "blur": 0.5,
            "range": 0.9,
            "squeeze": 1.4,
            "focus": "auto"
          }
        }
      },
      {
        "id": "k2",
        "tMs": 3400,
        "pose": {
          "target": [0, -0.2, 0],
          "azimuthDeg": 0,
          "elevationDeg": 2,
          "distance": 5.2
        }
      }
    ],
    "segments": [{ "from": "k1", "to": "k2", "ease": "inOutCubic" }]
  },
  "lighting": {
    "preset": "neon-corridor",
    "environment": {
      "source": "kookaburra:warehouse",
      "intensity": 0.35,
      "rotationDeg": 0
    },
    "sun": {
      "azimuthDeg": 0,
      "elevationDeg": 45,
      "intensity": 1,
      "enabled": false
    },
    "ambient": 0.05,
    "fixtures": [
      {
        "id": "tubes",
        "form": "tube",
        "size": [3.2, 0.06],
        "kelvin": 4200,
        "emissive": 1.4,
        "lightIntensity": 17,
        "placement": { "mode": "point", "position": [0, 3.4, 3.2] },
        "rotationDeg": [-90, 0, 0],
        "repeat": { "count": 4, "spacing": 2.4, "axis": "z" }
      }
    ],
    "keys": [
      {
        "id": "l1",
        "tMs": 0,
        "pose": { "fixtures": { "tubes": { "emissive": 0.7, "lightIntensity": 7 } } }
      },
      {
        "id": "l2",
        "tMs": 2600,
        "pose": { "fixtures": { "tubes": { "emissive": 1.4, "lightIntensity": 17 } } }
      }
    ],
    "segments": [{ "from": "l1", "to": "l2", "ease": "inOutSine" }]
  },
  "textAnimation": {
    "in": "fade-up",
    "out": "fade",
    "staggerMs": 90,
    "stagger": "word"
  },
  "backdrop": {
    "type": "none"
  },
  "background": {
    "type": "gradient",
    "parallax": 0.03,
    "spec": {
      "type": "linear",
      "angleDeg": 180,
      "space": "oklch",
      "stops": [
        ["#2E1F05", 0],
        ["#322306", 0.25],
        ["#352507", 0.5],
        ["#382807", 0.75],
        ["#3A2A08", 1]
      ]
    }
  }
}
