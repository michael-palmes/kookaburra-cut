{
  "version": 1,
  "name": "Fixed list",
  "text": {
    "title": "You reported these",
    "bullets": "Sync no longer stalls\nWidgets refresh on wake\nAttachments open again\nEditor keeps your place"
  },
  "frame": {
    "cutout": {
      "shape": "none"
    },
    "chip": {
      "label": "Fixed",
      "icon": "circle-check",
