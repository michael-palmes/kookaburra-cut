{
  "version": 1,
  "name": "Read the full notes",
  "text": {
    "title": "example.com/changelog",
    "subtitle": "Full notes"
  },
  "textAnimation": {
    "in": "fade-up",
    "out": "none",
    "staggerMs": 160,
    "delivery": "by-paragraph"
  },
  "backdrop": {
    "type": "none"
  },
  "background": {
    "type": "shader",
    "shader": "dot-grid",
    "colors": ["#0f141b", "#2e405b", "#416198"],
    "speed": 0.25,
    "params": {
      "density": 50,
      "dotSize": 0.19,
      "pulse": 0.45,
      "waveWidth": 0.5,
      "driftAngle": 70
    },
    "preset": "p6"
  }
}
