{
  "version": 1,
  "name": "Added in action",
  "text": {
    "title": "Offline mode",
    "subtitle": ""
  },
  "textAnimation": {
    "in": "fade-up",
    "out": "none",
    "staggerMs": 160,
    "delivery": "by-paragraph"
  },
  "videoWindow": {
    "media": {
      "src": "assets/kooka-feed-loop-sample.mp4",
      "startMs": 0,
      "loop": true
    },
    "radius": "macos",
    "scale": 0.68,
    "offset": [0, -0.08],
    "motion": {
      "preset": "none"
    }
  },
  "backdrop": {
    "type": "none"
  },
  "background": {
    "type": "shader",
    "shader": "dot-grid",
    "colors": ["#0f141b", "#2e405b", "#416198"],
    "speed": 0.25,
    "params": {
      "density": 50,
      "dotSize": 0.19,
      "pulse": 0.45,
      "waveWidth": 0.5,
      "driftAngle": 70
    },
    "preset": "p6"
  }
}
