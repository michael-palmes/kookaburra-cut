{
  "version": 1,
  "name": "Release header",
  "text": {
    "title": "v2.4.0",
    "subtitle": "6 August 2026"
  },
  "headerIcon": "assets/app-icon.png",
  "textLayout": {
    "align": "center"
  },
  "textStyle": {
    "titleFont": "JetBrains Mono",
    "subtitleFont": "JetBrains Mono"
  },
  "textAnimation": {
    "in": "fade-up",
    "out": "none",
    "staggerMs": 160,
    "delivery": "by-paragraph"
  },
  "backdrop": {
    "type": "none"
  },
  "background": {
    "type": "shader",
    "shader": "graph-grid",
    "colors": ["#0d1218", "#2f485c", "#3a6588", "#25343e"],
    "speed": 0.3,
    "params": {
      "density": 8,
      "lineWeight": 0.6,
      "highlightWidth": 0.55,
      "fillDensity": 0.12,
      "cadence": 0.15
    },
    "preset": "p8"
  }
}
