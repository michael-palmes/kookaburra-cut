{
  "version": 1,
  "name": "We rebuilt it",
  "text": {
    "title": "We rebuilt it",
    "subtitle": "Every screen"
  },
  "textLayout": { "align": "center" },
  "textStyle": { "titleSize": 0.75, "subtitleSize": 1.3 },
