{
  "version": 1,
  "name": "Migration",
  "text": {
    "title": "How to migrate",
    "subtitle": "About ten minutes on a mid-sized app",
    "bullets": "Bump the SDK to 4.2.0\nPass a region to createClient\nRun the codemod for callbacks"
  },
  "textStyle": {
    "bulletsFont": "JetBrains Mono"
  },
  "textAnimation": {
    "in": "fade",
    "out": "none",
    "staggerMs": 160,
    "delivery": "by-paragraph"
  },
  "frame": {
    "cutout": {
      "shape": "none"
    },
    "chip": {
      "label": "Migrate",
      "icon": "circle-check"
    },
    "textAlign": "center"
  },
  "backdrop": {
    "type": "none"
  },
  "background": {
    "type": "shader",
    "shader": "dot-grid",
    "colors": ["#0f141b", "#2e405b", "#416198"],
    "speed": 0.25,
    "parallax": 0,
    "params": {
      "density": 50,
      "dotSize": 0.19,
      "pulse": 0.45,
      "waveWidth": 0.5,
      "driftAngle": 70
    },
    "preset": "p6"
  }
}
