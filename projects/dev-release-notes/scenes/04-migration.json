{
  "version": 1,
  "name": "Migration",
  "text": {
    "title": "How to migrate",
    "subtitle": "About ten minutes",
    "code": "$ npm i sdk@4.2.0\n$ npx sdk-codemod\n$ npm test"
  },
  "textStyle": {
    "codeFont": "JetBrains Mono",
    "titleSize": 0.82
  },
  "textAnimation": {
    "in": "fade",
    "out": "none",
    "staggerMs": 160,
    "delivery": "by-paragraph"
  },
  "frame": {
    "cutout": {
      "shape": "rect",
      "side": "end",
      "size": 0.46,
      "inset": 0.075
    },
    "chip": {
      "label": "Migrate",
      "icon": "circle-check"
    },
    "background": "#0f141b",
    "textAlign": "left"
  },
  "backdrop": {
    "type": "none"
  },
  "background": {
    "type": "shader",
    "shader": "dot-grid",
    "colors": ["#0f141b", "#2e405b", "#416198"],
    "speed": 0.25,
    "parallax": 0,
    "params": {
      "density": 50,
      "dotSize": 0.19,
      "pulse": 0.45,
      "waveWidth": 0.5,
      "driftAngle": 70
    },
    "preset": "p6"
  }
}
