{
  "id": "transition-spike",
  "name": "Transition FX",
  "version": 2,
  "themeId": "kookaburra-default",
  "formats": ["16:9", "9:16", "1:1"],
  "scenes": [
    {
      "file": "scenes/01-base.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "crossfade",
        "durationMs": 600
      }
    },
    {
      "file": "scenes/02-crossfade.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "dip",
        "durationMs": 600
      }
    },
    {
      "file": "scenes/03-dip.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "blur",
        "durationMs": 600
      }
    },
    {
      "file": "scenes/04-blur.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "push",
        "durationMs": 600
      }
    },
    {
      "file": "scenes/05-push.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "zoom",
        "durationMs": 600
      }
    },
    {
      "file": "scenes/06-zoom.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "whip",
        "durationMs": 600
      }
    },
    {
      "file": "scenes/07-whip.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "luma",
        "durationMs": 600,
        "shape": "iris"
      }
    },
    {
      "file": "scenes/08-luma.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "glitch",
        "durationMs": 600
      }
    },
    {
      "file": "scenes/09-glitch.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "slice",
        "durationMs": 600
      }
    },
    {
      "file": "scenes/10-slice.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "dissolve",
        "durationMs": 700,
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/11-dissolve.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "warp",
        "durationMs": 500,
        "ease": "snappy"
      }
    },
    {
      "file": "scenes/12-warp.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "inkbleed",
        "durationMs": 800,
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/13-inkbleed.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "flowmorph",
        "durationMs": 900,
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/14-flowmorph.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "shockwave",
        "durationMs": 600,
        "steps": 2
      }
    },
    {
      "file": "scenes/15-shockwave.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "glasssweep",
        "durationMs": 700,
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/16-glasssweep.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "rackfocus",
        "durationMs": 800,
        "shape": "hex",
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/17-rackfocus.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "halftone",
        "durationMs": 700
      }
    },
    {
      "file": "scenes/18-halftone.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "lightsweep",
        "durationMs": 500,
        "color": "#ffffff",
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/19-lightsweep.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "shatter",
        "durationMs": 700,
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/20-shatter.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "pixelstretch",
        "durationMs": 600
      }
    },
    {
      "file": "scenes/21-pixelstretch.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "chromasplit",
        "durationMs": 500,
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/22-chromasplit.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "datamosh",
        "durationMs": 500
      }
    },
    {
      "file": "scenes/23-datamosh.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "prism",
        "durationMs": 700,
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/24-prism.tsx",
      "durationMs": 1800,
      "transition": {
        "type": "spinblur",
        "durationMs": 400,
        "ease": "smooth"
      }
    },
    {
      "file": "scenes/25-spinblur.tsx",
      "durationMs": 1800
    }
  ]
}
