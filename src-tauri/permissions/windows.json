{
  "permission": [
    {
      "identifier": "studio",
      "description": "The main window's own chrome: opening the other windows, the workspace's first-run default and path display.",
      "commands": {
        "allow": [
          "open_present",
          "open_edit",
          "open_edit_named",
          "list_edits",
          "edit_stamps",
          "open_settings",
          "open_pack_import",
          "open_pack_export",
          "next_queued_pack",
          "open_theme_editor_window",
          "init_default_workspace",
          "default_workspace_root",
          "user_home_dir",
          "pick_folder"
        ]
      }
    },
    {
      "identifier": "claude-launcher",
      "description": "The Claude desktop app handoff, the answer to whether Claude is on, its preferences and the two fixed pages the app opens in the browser (the Claude download and the privacy page).",
      "commands": {
        "allow": [
          "claude_app_status",
          "claude_status",
          "set_claude_consent",
          "open_in_claude",
          "open_project_folder",
          "open_claude_download",
          "open_privacy_page",
          "set_claude_preferences"
        ]
      }
    },
    {
      "identifier": "managed",
      "description": "The effective managed-preferences policy, so a window can hide or lock what a configuration profile governs.",
      "commands": {
        "allow": ["managed_policy"]
      }
    },
    {
      "identifier": "updater",
      "description": "The consent-gated update check and install.",
      "commands": {
        "allow": [
          "check_for_update",
          "set_update_consent",
          "install_update_and_relaunch",
          "updates_left_to_installer"
        ]
      }
    }
  ]
}
