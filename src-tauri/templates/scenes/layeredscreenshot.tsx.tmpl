import { defineScene, LayeredScreenshot, SceneStage, useSceneText, useTheme } from "@kookaburra/toolkit";

/**
 * __NAME__ — scaffolded layered-screenshot scene. The stack itself (layers, screens,
 * text labels, pose, animation) and optional managed title live in the sidecar
 * `scenes/__STEM__.json`; compose anything extra around it with toolkit primitives.
 */
export default defineScene({
  id: "__SCENE_ID__",
  durationMs: __DURATION_MS__,
  Scene() {
    const theme = useTheme();
    const title = useSceneText("title");
    return (
      <SceneStage>
        <color attach="background" args={[theme.colors.background]} />
        <LayeredScreenshot title={title} />
      </SceneStage>
    );
  },
});
