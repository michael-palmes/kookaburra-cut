import { AnimatedHeadline, Chart, defineScene, SceneStage, useFormat, useSceneText, useTheme } from "@kookaburra/toolkit";

/**
 * __NAME__: scaffolded chart scene. The chart itself (type, dimension, data, axes,
 * labels, build-in) lives in the sidecar `scenes/__STEM__.json` `chart` block and is
 * edited in the app; the optional title rides the managed text block. Compose anything extra
 * around it with toolkit primitives. See the kookaburra-scene-authoring skill
 * ("Scene documents").
 */
export default defineScene({
  id: "__SCENE_ID__",
  durationMs: __DURATION_MS__,
  Scene() {
    const theme = useTheme();
    const format = useFormat();
    const portrait = format.aspect < 1;
    const title = useSceneText("title");
    return (
      <SceneStage>
        <color attach="background" args={[theme.colors.background]} />
        {title ? (
          <AnimatedHeadline
            text={title}
            textKey="title"
            from={200}
            to={900}
            position={[0, portrait ? 1.9 : 1.72, 0]}
            fontSize={portrait ? 0.23 : 0.42}
          />
        ) : null}
        <Chart />
      </SceneStage>
    );
  },
});
