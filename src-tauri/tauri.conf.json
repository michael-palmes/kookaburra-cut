{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kookaburra Cut",
  "version": "0.20.1",
  "identifier": "com.mpalmes.kookaburracut",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kookaburra Cut",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 23
        },
        "theme": "Dark",
        "backgroundColor": "#0D1016"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/cache/**", "$HOME/Kookaburra Cut/**"],
          "requireLiteralLeadingDot": false
        }
      },
      "csp": "default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' blob: 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data: asset: http://asset.localhost; connect-src 'self' blob: ipc: http://ipc.localhost asset: http://asset.localhost",
      "devCsp": "default-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' blob: 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data: asset: http://asset.localhost; connect-src 'self' blob: ipc: http://ipc.localhost asset: http://asset.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFOEVFNjRCMDcxMURENkYKUldSdjNSRUhTK2FPL3RWMlFLVjhlYnhZZmxOdnpTaldodGxMTTh6SWVoNVZ5L1dUYlVzRVVnd1gK",
      "endpoints": [
        "https://github.com/michael-palmes/kookaburra-cut/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true,
      "minimumSystemVersion": "26.0"
    },
    "externalBin": ["bin/ffmpeg", "bin/ffprobe"],
    "resources": {
      "../projects": "projects",
      "../presets": "presets",
      "../src/assets/template-previews": "template-previews",
      "../src/assets/preset-previews": "preset-previews",
      "../.agents/skills/kookaburra-scene-authoring/*.md": "claude-skills/kookaburra-scene-authoring/",
      "../.agents/skills/kookaburra-scene-authoring/catalog.json": "claude-skills/kookaburra-scene-authoring/catalog.json",
      "../.agents/skills/kookaburra-scene-authoring/reference": "claude-skills/kookaburra-scene-authoring/reference",
      "../.agents/skills/kookaburra-scene-authoring/scripts/*.py": "claude-skills/kookaburra-scene-authoring/scripts/",
      "../.agents/skills/kookaburra-scene-authoring/scripts/kblib": "claude-skills/kookaburra-scene-authoring/scripts/kblib",
      "../.agents/skills/kookaburra-video-editing/*.md": "claude-skills/kookaburra-video-editing/",
      "../.agents/skills/kookaburra-video-editing/reference": "claude-skills/kookaburra-video-editing/reference",
      "../.agents/skills/kookaburra-brand-packs/*.md": "claude-skills/kookaburra-brand-packs/",
      "../.agents/skills/kookaburra-brand-packs/reference": "claude-skills/kookaburra-brand-packs/reference",
      "../.agents/skills/kookaburra-brand-packs/scripts/*.py": "claude-skills/kookaburra-brand-packs/scripts/",
      "../.agents/skills/kookaburra-brand-packs/scripts/*.js": "claude-skills/kookaburra-brand-packs/scripts/",
      "resources/models/beat_this_small.onnx": "models/beat_this_small.onnx",
      "resources/models/mel_spectrogram.onnx": "models/mel_spectrogram.onnx"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["kbpack"],
        "name": "Kookaburra Pack",
        "role": "Editor",
        "mimeType": "application/vnd.kookaburracut.pack+zip",
        "exportedType": {
          "identifier": "com.kookaburracut.pack",
          "conformsTo": ["public.data", "public.archive"]
        }
      }
    ]
  }
}
