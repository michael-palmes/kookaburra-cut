{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "theme-editor",
  "description": "Capabilities for the Kookaburra Cut theme editor window. Dialog covers the unsaved-changes confirm; it reads the specimen project and writes only theme documents through path-confined Rust commands.",
  "windows": ["theme-editor"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:path:allow-resolve-directory",
    "core:path:allow-join",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:default",
    "project-read",
    "project-render",
    "theme-editor-window"
  ]
}
