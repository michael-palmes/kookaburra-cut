{
  "version": 1,
  "name": "Before and after",
  "text": {
    "beforeLabel": "Before",
    "afterLabel": "After"
  },
  "backdrop": {
    "type": "none"
  },
  "background": {
    "type": "gradient",
    "gradient": "brand",
    "parallax": 0.03
  },
  "devices": [
    {
      "id": "hero",
      "model": "iphone-17-pro",
      "colour": "silver",
      "media": { "src": "assets/home-old-sample.jpg", "kind": "image" },
      "placement": { "position": [0, -0.1, 0], "rotationDeg": [0, 0, 0], "scale": 1.3 },
      "motion": { "preset": "none" },
      "shadow": "soft"
    }
  ],
  "compare": {
    "b": {
      "media": {
        "hero": { "src": "assets/home-new-sample.jpg", "kind": "image" }
      }
    },
    "mask": { "type": "linear", "angleDeg": 70, "softness": 0.02 },
    "value": 0.9,
    "track": {
      "keys": [
        { "id": "k1", "tMs": 1000, "pose": { "value": 0.9 } },
        { "id": "k2", "tMs": 3550, "pose": { "value": 0.1 } }
      ],
      "segments": [{ "from": "k1", "to": "k2", "ease": "inOutQuad" }]
    },
    "chrome": {
      "line": { "width": 2, "colour": "muted", "softness": 2 },
      "grip": false,
      "chips": true,
      "tint": { "a": "background", "amount": 0.15 }
    }
  },
  "animatedTrack": "compare"
}
