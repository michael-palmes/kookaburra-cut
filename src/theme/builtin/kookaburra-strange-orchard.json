{
  "version": 2,
  "id": "kookaburra-strange-orchard",
  "name": "Strange Orchard",
  "mode": "light",
  "catalogue": {
    "category": "sensory-and-surreal",
    "useLabel": "Unexpected challenger campaigns",
    "tags": ["challenger", "unexpected", "organic", "surreal", "campaign", "experimental"],
    "stage": "lighting-only",
    "order": 30
  },
  "colors": {
    "background": "#f5f0dc",
    "text": "#241d0c",
    "accent": "#78611b",
    "muted": "#30260e"
