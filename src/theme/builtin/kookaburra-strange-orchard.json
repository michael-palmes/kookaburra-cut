    "backing": {
      "type": "color",
      "color": "#f5f0dc"
    },
    "preset": "p1"
  },
  "lighting": {
    "key": {
      "azimuthDeg": -35,
      "elevationDeg": 44,
      "intensity": 1.9,
      "color": "#fff5cf"
    },
    "fills": [
      {
        "azimuthDeg": 120,
        "elevationDeg": 22,
        "intensity": 0.75,
        "color": "#d4a55e"
      },
      {
        "azimuthDeg": 160,
        "elevationDeg": 34,
        "intensity": 0.4,
        "color": "#9fc8ae"
      }
    ],
    "ambient": 0.7
