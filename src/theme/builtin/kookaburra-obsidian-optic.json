    "fills": [
      {
        "azimuthDeg": 140,
        "elevationDeg": 20,
        "intensity": 0.9,
        "color": "#4ec5b2"
      },
      {
        "azimuthDeg": 165,
        "elevationDeg": 35,
        "intensity": 0.55,
        "color": "#8da6ff"
      }
