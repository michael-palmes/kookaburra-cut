{
  "version": 2,
  "id": "kookaburra-onyx",
  "name": "Onyx",
  "mode": "dark",
  "catalogue": {
    "category": "essentials",
    "useLabel": "Keynote-style reveals",
    "tags": ["dark", "keynote", "premium", "product", "cinematic", "minimal"],
    "stage": "lighting-only",
    "order": 20
  },
  "colors": {
    "background": "#000000",
    "text": "#f5f5f7",
    "accent": "#2997ff",
    "muted": "#b0b0b5"
  },
  "gradients": {
    "brand": {
      "type": "radial",
      "angleDeg": 0,
      "stops": [["#1b1b1e", 0], ["#000000", 1]],
      "space": "oklch"
    }
  },
  "chartColors": ["#2997ff", "#30d158", "#ff9f0a", "#bf5af2", "#ff6961", "#64d2ff"],
  "typography": {
    "headline": {
      "family": "Inter",
      "weight": 600
    },
    "body": "Inter",
    "scale": 1.2
  },
  "motion": {
    "durations": {
      "fast": 200,
      "base": 520,
      "slow": 940
    },
    "easings": {
      "standard": "outCubic",
      "emphasized": "outExpo"
    }
  },
  "textAnimation": {
    "in": "fade-scale",
    "out": "fade",
    "staggerMs": 0,
    "startScale": 0.96
  },
  "lighting": {
    "key": {
      "azimuthDeg": -30,
      "elevationDeg": 42,
      "intensity": 1.9,
      "color": "#eef2ff"
    },
    "fills": [
      {
        "azimuthDeg": 140,
        "elevationDeg": 12,
        "intensity": 0.5,
        "color": "#4a5368"
      },
      {
        "azimuthDeg": 165,
        "elevationDeg": 38,
        "intensity": 0.85,
        "color": "#b8c2d8"
      }
    ],
    "ambient": 0.38
  },
  "environment": {
    "source": "kookaburra:monochrome-studio",
    "intensity": 0.6,
    "rotationDeg": 0
  },
  "background": {
    "type": "gradient",
    "gradient": "brand",
    "parallax": 0.03
  }
}
