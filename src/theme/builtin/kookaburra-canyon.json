{
  "version": 2,
  "id": "kookaburra-canyon",
  "name": "Canyon",
  "mode": "dark",
  "catalogue": {
    "category": "retro",
    "useLabel": "Warm, nostalgic storytelling",
    "tags": ["1970s", "earth", "brown", "amber", "warm", "film"],
    "stage": "lighting-only",
    "order": 40
  },
  "colors": {
    "background": "#24170f",
    "text": "#f6ead8",
    "accent": "#e9a14f",
    "muted": "#d0bba1"
