{
  "version": 2,
  "id": "kookaburra-scribble-protocol",
  "name": "Scribble Protocol",
  "mode": "light",
  "catalogue": {
    "category": "maker-energy",
    "useLabel": "Rapid developer stories",
    "tags": ["developer", "rapid", "technical", "hand-drawn", "prototype", "experimental"],
    "stage": "lighting-only",
    "order": 40
  },
  "colors": {
    "background": "#e2f3fb",
    "text": "#102b35",
    "accent": "#006f8f",
    "muted": "#294752"
  },
  "chartColors": ["#006f8f", "#243dc5", "#7e22ce", "#b91c1c", "#18733b", "#5f3000"],
  "typography": {
    "headline": { "family": "JetBrains Mono", "weight": 400 },
    "body": { "family": "Libre Franklin", "weight": 600 },
    "scale": 1.2
  },
  "motion": {
    "durations": { "fast": 150, "base": 390, "slow": 760 },
    "easings": { "standard": "outCubic", "emphasized": "outExpo" }
  },
  "textAnimation": {
    "in": "twist-scale",
    "out": "fade",
    "staggerMs": 32,
    "stagger": "char",
    "direction": "from-left"
  },
  "background": {
    "type": "scene3d",
    "look": "grid-plain",
    "colors": ["#7ccae3"],
    "speed": 1,
    "params": {
      "spacing": 1.2,
      "height": -1.3,
      "clearRadius": 4,
      "fadeRadius": 40,
      "drift": 1,
      "opacity": 0.8
    },
    "backing": {
      "type": "color",
      "color": "#e2f3fb"
    },
    "preset": "p1"
  },
  "lighting": {
    "key": {
      "azimuthDeg": 28,
      "elevationDeg": 56,
      "intensity": 1.9,
      "color": "#f8fdff"
    },
    "fills": [
      {
        "azimuthDeg": -135,
        "elevationDeg": 18,
        "intensity": 0.7,
        "color": "#8dd4e8"
      }
    ],
    "ambient": 0.75
  }
}
