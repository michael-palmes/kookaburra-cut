{
  "version": 2,
  "id": "kookaburra-lilac",
  "name": "Lilac",
  "mode": "light",
  "catalogue": {
    "category": "studio",
    "useLabel": "Creative and lifestyle apps",
    "tags": ["lavender", "purple", "soft", "creative", "lifestyle", "serif"],
    "stage": "lighting-only",
    "order": 50
  },
  "colors": {
    "background": "#f2eef8",
    "text": "#1d1530",
    "accent": "#6236c9",
    "muted": "#544a68"
  },
  "chartColors": ["#6236c9", "#b4235a", "#0e7490", "#a16207", "#334155", "#15803d"],
  "typography": {
    "headline": {
      "family": "Instrument Serif",
      "weight": 400
    },
    "body": "Inter",
    "scale": 1.2
  },
  "motion": {
    "durations": {
      "fast": 200,
      "base": 520,
      "slow": 940
    },
    "easings": {
      "standard": "outCubic",
      "emphasized": "outExpo"
    }
  },
  "textAnimation": {
    "in": "blur-in",
    "out": "fade",
    "staggerMs": 35,
    "stagger": "word"
  },
  "lighting": {
    "key": {
      "azimuthDeg": 35,
      "elevationDeg": 55,
      "intensity": 2.0,
      "color": "#fdf9ff"
    },
    "fills": [
      {
        "azimuthDeg": -120,
        "elevationDeg": 18,
        "intensity": 0.8,
        "color": "#efe8ff"
      }
    ],
    "ambient": 0.85,
    "shadow": {
      "technique": "map",
      "softness": 0.7,
      "opacity": 0.24,
      "mapSize": 2048,
      "bias": -0.0005,
      "color": "#2a2040"
    }
  },
  "environment": {
    "source": "kookaburra:cyclorama",
    "intensity": 0.95,
    "rotationDeg": 0
  },
  "background": {
    "type": "shader",
    "shader": "mesh-gradient",
    "colors": ["#f6f3fb", "#ebe4f6", "#f1e9f7", "#f5f1fa"],
    "speed": 0.16,
    "params": {
      "distortion": 0.45,
      "swirl": 0.04
    }
  }
}
