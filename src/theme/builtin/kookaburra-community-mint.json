{
  "version": 2,
  "id": "kookaburra-community-mint",
  "name": "Community Mint",
  "mode": "light",
  "catalogue": {
    "category": "digital-assets",
    "useLabel": "Friendly crypto onboarding",
    "tags": ["crypto", "onboarding", "community", "wallet", "friendly", "experimental"],
    "stage": "lighting-only",
    "order": 40
  },
  "colors": {
    "background": "#eef6f3",
    "text": "#132b26",
    "accent": "#16705d",
    "muted": "#354c47"
  },
  "chartColors": ["#16705d", "#315e9a", "#375f32", "#7a3f78", "#8b541d", "#594c84"],
  "typography": {
    "headline": { "family": "Nunito", "weight": 600 },
    "body": { "family": "Open Sans", "weight": 400 },
    "scale": 1.25
  },
  "motion": {
    "durations": { "fast": 190, "base": 480, "slow": 860 },
    "easings": { "standard": "outCubic", "emphasized": "outBack" }
  },
  "textAnimation": {
    "in": "fade-up",
    "out": "fade",
    "staggerMs": 48,
    "stagger": "word"
  },
  "background": {
    "type": "shader",
    "shader": "simplex-noise",
    "colors": ["#eef6f3", "#d9ece6", "#c4e2d8", "#afd7ca", "#9acdbd"],
    "speed": 0.4,
    "params": {
      "stepsPerColor": 2,
      "softness": 0.5
    },
    "preset": "p3"
  },
  "lighting": {
    "key": {
      "azimuthDeg": -26,
      "elevationDeg": 50,
      "intensity": 2,
      "color": "#fbfffd"
    },
    "fills": [
      {
        "azimuthDeg": 136,
        "elevationDeg": 22,
        "intensity": 0.75,
        "color": "#b8ded2"
      },
      {
        "azimuthDeg": 168,
        "elevationDeg": 34,
        "intensity": 0.3,
        "color": "#c7d8f0"
      }
    ],
    "ambient": 0.8
  }
}
