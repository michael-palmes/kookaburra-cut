{
  "name": "kookaburra-cut",
  "version": "0.20.1",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@11.0.4",
  "description": "AI driven, deterministic animated-video studio for macOS (Apple Silicon). Tauri 2 + React 19 + react-three-fiber, exporting via a bundled ffmpeg sidecar.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michael-palmes/kookaburra-cut.git"
  },
  "bugs": {
    "url": "https://github.com/michael-palmes/kookaburra-cut/issues"
  },
  "homepage": "https://kookaburracut.com/",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "bash scripts/seed-cargo-target.sh",
    "test": "vitest run && node --test scripts/*.test.mjs && pnpm test:kit",
    "test:kit": "node scripts/test-kit.mjs",
    "test:kit:e2e": "python3 -B -m unittest discover -s .agents/skills/kookaburra-scene-authoring/scripts/tests -t .agents/skills/kookaburra-scene-authoring/scripts -p 'test_video_e2e.py'",
    "test:watch": "vitest",
    "agent:catalog": "KB_WRITE_CATALOG=1 vitest run src/agentKit/catalog.test.ts && biome format --write .agents/skills/kookaburra-scene-authoring/catalog.json",
    "agent:vectors": "KB_WRITE_VECTORS=1 vitest run src/agentKit/editVectors.test.ts src/agentKit/repointVectors.test.ts src/agentKit/timelineVectors.test.ts src/agentKit/musicVectors.test.ts src/agentKit/themeMergeVectors.test.ts && biome format --write --no-errors-on-unmatched .agents/skills/kookaburra-scene-authoring/scripts/tests/fixtures/edit-vectors.json .agents/skills/kookaburra-scene-authoring/scripts/tests/fixtures/repoint-vectors.json .agents/skills/kookaburra-scene-authoring/scripts/tests/fixtures/timeline-vectors.json .agents/skills/kookaburra-scene-authoring/scripts/tests/fixtures/music-vectors.json .agents/skills/kookaburra-scene-authoring/scripts/tests/fixtures/theme-merge-vectors.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "setup:ffmpeg": "bash scripts/setup-ffmpeg.sh",
    "setup:ffmpeg:release": "bash scripts/build-ffmpeg-sidecar.sh",
    "setup:models": "bash scripts/setup-models.sh",
    "setup:icon": "bash scripts/make-icons.sh",
    "setup:target": "bash scripts/seed-cargo-target.sh",
    "clean:shell": "cargo clean --manifest-path src-tauri/Cargo.toml -p kookaburra-cut",
    "assets:hdri": "zsh scripts/prepare-hdri.sh",
    "assets:placeholder-phone": "BLENDER=${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}; $BLENDER -b -P scripts/make-placeholder-phone.py -- src/assets/models/placeholder-phone.glb",
    "assets:phone": "bash scripts/prepare-device-model.sh iphone-15-pro",
    "assets:iphone-17-pro": "bash scripts/prepare-device-model.sh iphone-17-pro",
    "assets:macbook-pro-16": "bash scripts/prepare-device-model.sh macbook-pro-16",
    "assets:ipad-pro-13": "bash scripts/prepare-device-model.sh ipad-pro-13",
    "assets:iphone-duo": "bash scripts/prepare-device-model.sh iphone-duo",
    "assets:android": "bash scripts/prepare-android-model.sh",
    "assets:devices": "bash scripts/prepare-device-model.sh iphone-15-pro && bash scripts/prepare-device-model.sh iphone-17-pro && bash scripts/prepare-device-model.sh macbook-pro-16 && bash scripts/prepare-device-model.sh ipad-pro-13 && bash scripts/prepare-device-model.sh iphone-duo && pnpm assets:device-screens",
    "assets:device-screens": "KB_WRITE_SCREENS=1 vitest run src/toolkit/device/screenGeometry.test.ts && biome format --write src/toolkit/device/screenGeometry.ts",
    "assets:device-previews": "bash scripts/render-device-previews.sh",
    "assets:text3d-font": "node scripts/prepare-text3d-font.mjs",
    "assets:emoji-fonts": "node scripts/prepare-emoji-fonts.mjs",
    "acceptance:app": "node scripts/acceptance-app.mjs",
    "kookaburra:run": "bash scripts/kookaburra-run.sh",
    "gate": "node scripts/ready.mjs --legs showcase-tour",
    "gate:merge": "node scripts/ready.mjs --legs showcase-tour,ws:launch-2026",
    "ready": "node scripts/ready.mjs",
    "look-lab": "node tools/look-lab/sheet.mjs",
    "package:dmg": "bash scripts/make-dmg.sh",
    "package:signed": "bash scripts/sign-and-notarize.sh",
    "release": "bash scripts/release.sh",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "animejs": "^4.5.0",
    "d3-array": "^3.2.4",
    "d3-ease": "^3.0.1",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "esbuild-wasm": "0.28.2",
    "postprocessing": "6.39.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.185.1",
    "troika-three-text": "0.52.5",
    "troika-three-utils": "0.52.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@fontsource/noto-sans-math": "^5.3.0",
    "@fontsource/noto-sans-symbols": "^5.3.0",
    "@fontsource/noto-sans-symbols-2": "^5.3.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.2",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
